  "version": "v1",
  "description": "物流域 NLU Center v1 评测集。样本覆盖 A 标准题、A 同义变体、B 澄清、C 不支持、多问题、极短口语和真实业务口吻。",
  "auto_expand_sources": {
    "enabled": true,
    "description": "评测脚本会在人工种子样本基础上，从 C2A、BCR、903 总账、Top200、TopN v2 产物中自动抽取代表题，形成 80-120 条可复跑评测集。",
    "targets": {
      "c2a_precise_a": 24,
      "bcr_clarification": 24,
      "ledger_c_unsupported": 12,
      "top200_a": 8,
      "topn_v2_a": 8
    }
  },
