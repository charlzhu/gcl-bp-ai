# =========================
# 应用基础配置
# =========================
APP_NAME=gcl-bp-ai
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# =========================
# 跨域与请求头
# =========================
TRACE_HEADER_NAME=X-Trace-Id
REQUEST_ID_HEADER_NAME=X-Request-Id
ALLOWED_ORIGINS=["*"]

# =========================
# 文件与日志目录
# =========================
FILE_STORAGE_ROOT=data/files
LOG_ROOT=data/logs

# =========================
# 本地中间库 MySQL
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=logistics_ai
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_CHARSET=utf8mb4

# =========================
# Redis
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =========================
# Milvus
# =========================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_PREFIX=gcl_bp_ai

# =========================
# 物流 NL2SQL M2 语义召回配置
# =========================
# 模型名称按百炼控制台实际开通名称填写；示例不包含任何真实密钥。
# 当前本地门禁已验证可用组合：text-embedding-v4（1024 维）+ gte-rerank-v2。
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=gte-rerank-v2
RERANK_ENDPOINT_PATH=/api/v1/services/rerank/text-rerank/text-rerank
NL2SQL_RECALL_TOP_K=12
NL2SQL_RERANK_TOP_K=6
NL2SQL_RERANK_MIN_SCORE=0.0

# =========================
# 源系统 MySQL（只读）
# =========================
SOURCE_MYSQL_HOST=<source_mysql_host>
SOURCE_MYSQL_PORT=19531
SOURCE_MYSQL_DB=<source_mysql_db>
SOURCE_MYSQL_USER=<source_mysql_user>
SOURCE_MYSQL_PASSWORD=<source_mysql_password>

# =========================
# 大模型配置（OpenAI 兼容模式，示例模型为 deepseek-v4-flash；Base URL 请按实际供应商填写）
# =========================
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-5a3f2e16b7ec4f9092dce6658143de1e
LLM_MODEL=deepseek-v4-flash
# 可选：真实 provider gate 需要代理时填写，支持 http://、https://、socks5://；默认空值不启用显式代理。
LLM_HTTP_PROXY=
LLM_HTTPS_PROXY=
LLM_ALL_PROXY=

# =========================
# 物流答案表达层配置
# =========================
LLM_ANSWER_PRESENTATION_ENABLED=true
LLM_ANSWER_PRESENTATION_MODEL=deepseek-v4-flash
LLM_ANSWER_PRESENTATION_TIMEOUT=30
LLM_ANSWER_PRESENTATION_MAX_RETRIES=1

# =========================
# Query Planning V2 响应 meta 暴露配置
# =========================
# 默认关闭；仅非生产环境且请求体 include_query_plan_v2_meta=true 时返回轻量审计 meta。
QUERY_PLANNING_V2_RESPONSE_META_ENABLED=false

# =========================
# NL2SQL 统一灰度配置（多域）
# =========================
# 启用 NL2SQL shadow 旁路
LOGISTICS_NL2SQL_LIVE_SHADOW_ENABLED=true
# 灰度接管：JSON 格式，key=域, value=启用的问题类型列表
# logistics: simple_aggregate, dimension_split, multi_metric_summary
# business_analysis: summary, breakdown, trend
# plan_bom: query, power
# NL2SQL_GRAYSCALE_CONFIG='{"logistics":["simple_aggregate"],"business_analysis":["summary"],"plan_bom":["query"]}'
# 旧格式（仅 logistics 域，逗号分隔）：
# LOGISTICS_NL2SQL_GRAYSCALE_TYPES=simple_aggregate,dimension_split
