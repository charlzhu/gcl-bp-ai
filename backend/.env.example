# =========================
# 应用基础配置
# =========================
APP_NAME=gcl-bp-ai
APP_ENV=local
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# =========================
# 跨域与请求头
# =========================
TRACE_HEADER_NAME=X-Trace-Id
REQUEST_ID_HEADER_NAME=X-Request-Id
ALLOWED_ORIGINS=["*"]

# =========================
# 文件与日志目录
# =========================
FILE_STORAGE_ROOT=data/files
LOG_ROOT=data/logs

# =========================
# 本地中间库 MySQL
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=logistics_ai
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_CHARSET=utf8mb4

# =========================
# Redis
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =========================
# Milvus
# =========================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# =========================
# 源系统 MySQL（只读）
# =========================
SOURCE_MYSQL_HOST=10.76.13.161
SOURCE_MYSQL_PORT=19531
SOURCE_MYSQL_DB=jyjh_db
SOURCE_MYSQL_USER=jyjhuser_zcc
SOURCE_MYSQL_PASSWORD="jyjh123!"

# =========================
# 大模型配置（OpenAI 兼容模式，示例为阿里云 DashScope）
# =========================
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=<your_dashscope_api_key>
LLM_MODEL=qwen-plus

# =========================
# 物流答案表达层配置
# =========================
LLM_ANSWER_PRESENTATION_ENABLED=true
LLM_ANSWER_PRESENTATION_MODEL=qwen-plus
LLM_ANSWER_PRESENTATION_TIMEOUT=30
LLM_ANSWER_PRESENTATION_MAX_RETRIES=1

# =========================
# Query Planning V2 响应 meta 暴露配置
# =========================
# 默认关闭；仅非生产环境且请求体 include_query_plan_v2_meta=true 时返回轻量审计 meta。
QUERY_PLANNING_V2_RESPONSE_META_ENABLED=false
