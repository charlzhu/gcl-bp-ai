+"""物流智能问答城市范围 + 物流公司分组回归测试。
+
+覆盖用户截图反馈：
+用户问“2025年常州的物流公司发运多少量？”，系统不能返回全国总发运量，
+必须把“常州”识别为城市过滤条件，并按物流公司/承运商分组展示。
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from backend.app.domains.logistics.repositories.data_qa_repository import LogisticsDataQaRepository
+from backend.app.domains.logistics.schemas.data_qa import LogisticsDataQaPlan, LogisticsDataQaQueryRequest
+from backend.app.domains.logistics.services.data_qa_planner import LogisticsDataQaPlanner
+from backend.app.domains.logistics.services.data_qa_service import LogisticsDataQaService
+from backend.app.domains.logistics.services.llm_answer_presentation_service import LogisticsLlmAnswerPresentationService
+
+
+class _FakeDb:
+    """供服务层写查询历史时使用的最小数据库替身。"""
+
+    def commit(self) -> None:
+        """模拟提交事务。"""
+
+    def rollback(self) -> None:
+        """模拟回滚事务。"""
+
+
+class _FakeQueryLogRepository:
+    """供服务层写查询历史时使用的最小日志仓储替身。"""
+
+    def write_query_log(self, db: Any, payload: dict[str, Any]) -> int:
+        """返回固定日志 ID，避免测试依赖真实 sys_query_log。"""
+
+        return 1
+
+
+class _FakeCarrierRepository:
+    """只实现城市 + 承运商 KPI 测试需要的仓储替身。"""
+
+    def __init__(self) -> None:
+        """记录服务层下推到仓储层的过滤条件。"""
+
+        self.last_kwargs: dict[str, Any] | None = None
+
+    def hist_carrier_kpi_by_year(
+        self,
+        *,
+        year: int,
+        region_name: str | None = None,
+        city: str | None = None,
+    ) -> dict[str, Any]:
+        """模拟按城市过滤后的承运商 KPI 结果。"""
+
+        self.last_kwargs = {"year": year, "region_name": region_name, "city": city}
+        return {
+            "total_shipment_mw": 300.0,
+            "items": [
+                {"carrier_name": "常州A物流", "shipment_mw": 200.0, "shipment_share_pct": 66.67, "total_fee": 1000},
+                {"carrier_name": "常州B物流", "shipment_mw": 100.0, "shipment_share_pct": 33.33, "total_fee": 500},
+            ],
+        }
+
+
+class _ScalarResult:
+    """模拟 SQLAlchemy scalar 结果。"""
+
+    def scalar(self) -> float:
+        """返回固定总发运量。"""
+
+        return 300.0
+
+
+class _RowsResult:
+    """模拟 SQLAlchemy mappings().all() 链式结果。"""
+
+    def mappings(self) -> "_RowsResult":
+        """返回自身以兼容 mappings().all()。"""
+
+        return self
+
+    def all(self) -> list[dict[str, Any]]:
+        """返回固定承运商分组数据。"""
+
+        return [
+            {"carrier_name": "常州A物流", "shipment_mw": 200.0, "shipment_share_pct": 66.67, "total_fee": 1000},
+            {"carrier_name": "常州B物流", "shipment_mw": 100.0, "shipment_share_pct": 33.33, "total_fee": 500},
+        ]
+
+
+class _SqlCaptureDb:
+    """捕获仓储层 SQL 和参数，验证城市过滤是否进入分子与分母。"""
+
+    def __init__(self) -> None:
+        """初始化 SQL 捕获列表。"""
+
+        self.calls: list[tuple[str, dict[str, Any]]] = []
+
+    def execute(self, statement: Any, params: dict[str, Any]) -> _ScalarResult | _RowsResult:
+        """记录 SQL 与参数，并按调用顺序返回不同结果替身。"""
+
+        sql = str(statement)
+        self.calls.append((sql, dict(params)))
+        if len(self.calls) == 1:
+            return _ScalarResult()
+        return _RowsResult()
+
+
+def test_city_logistics_company_question_routes_to_city_carrier_kpi() -> None:
+    """验证“常州的物流公司发运多少量”不能退化为全国总发运量。"""
+
+    plan = LogisticsDataQaPlanner().build_plan("2025年常州的物流公司发运多少量？")
+
+    assert plan.query_key == "hist_carrier_kpi_by_year"
+    assert plan.intent == "ranking"
+    assert plan.dimensions == ["carrier_name"]
+    assert plan.group_by == ["carrier_name"]
+    assert plan.filters["year"] == 2025
+    assert plan.filters["city"] == "常州"
+    assert plan.filters.get("region_name") is None
+
+
+def test_city_carrier_scope_is_generic_not_hardcoded_to_changzhou() -> None:
+    """验证同类城市 + 承运商问法通用生效，而不是只 hardcode 常州。"""
+
+    plan = LogisticsDataQaPlanner().build_plan("2025年苏州的承运商发货量分别是多少？")
+
+    assert plan.query_key == "hist_carrier_kpi_by_year"
+    assert plan.dimensions == ["carrier_name"]
+    assert plan.filters["year"] == 2025
+    assert plan.filters["city"] == "苏州"
+
+
+def test_all_logistics_companies_question_does_not_fake_city_scope() -> None:
+    """验证“各物流公司”这类全局承运商分组不能被误抽成 city=各。"""
+
+    plan = LogisticsDataQaPlanner().build_plan("2025年各物流公司发运量是多少？")
+
+    assert plan.query_key == "hist_carrier_kpi_by_year"
+    assert plan.dimensions == ["carrier_name"]
+    assert plan.filters["year"] == 2025
+    assert plan.filters.get("city") is None
+
+
+def test_city_filter_is_passed_from_service_to_carrier_repository() -> None:
+    """验证服务层执行承运商 KPI 时不会丢失城市过滤条件。"""
+
+    repository = _FakeCarrierRepository()
+    service = LogisticsDataQaService(
+        db=_FakeDb(),
+        repository=repository,
+        query_log_repository=_FakeQueryLogRepository(),
+        answer_presentation_service=LogisticsLlmAnswerPresentationService(enabled=True, base_url=None, api_key=None, model=""),
+    )
+    plan = LogisticsDataQaPlan(
+        intent="ranking",
+        query_key="hist_carrier_kpi_by_year",
+        metrics=["shipment_mw", "shipment_share_pct", "total_fee"],
+        dimensions=["carrier_name"],
+        filters={"year": 2025, "city": "常州", "region_name": None, "view_mode": "full_kpi"},
+        group_by=["carrier_name"],
+    )
+
+    result = service._execute_plan("2025年常州的物流公司发运多少量？", plan)
+
+    assert repository.last_kwargs == {"year": 2025, "region_name": None, "city": "常州"}
+    assert result.result_table.columns == ["carrier_name", "shipment_mw", "shipment_share_pct", "total_fee"]
+    assert len(result.result_table.rows) == 2
+    assert "常州" in result.answer_summary
+    assert "总发运量" not in result.answer_summary
+
+
+def test_service_query_for_city_carrier_question_keeps_city_scope() -> None:
+    """验证正式 query 链路不会在 planner 前置钩子处崩溃，并保留城市承运商范围。"""
+
+    repository = _FakeCarrierRepository()
+    service = LogisticsDataQaService(
+        db=_FakeDb(),
+        repository=repository,
+        query_log_repository=_FakeQueryLogRepository(),
+        answer_presentation_service=LogisticsLlmAnswerPresentationService(enabled=False, base_url=None, api_key=None, model=""),
+    )
+
+    result = service.query(LogisticsDataQaQueryRequest(question="2025年常州的物流公司发运多少量？"))
+
+    assert repository.last_kwargs == {"year": 2025, "region_name": None, "city": "常州"}
+    assert result.query_plan.query_key == "hist_carrier_kpi_by_year"
+    assert result.query_plan.filters["city"] == "常州"
+    assert result.result_table.columns == ["carrier_name", "shipment_mw", "shipment_share_pct", "total_fee"]
+    assert len(result.result_table.rows) == 2
+    assert "常州" in result.answer_summary
+    assert "总发运量" not in result.answer_summary
+
+
+def test_repository_city_filter_applies_to_total_denominator_and_group_rows() -> None:
+    """验证仓储层城市过滤同时进入总量分母和承运商分组分子。"""
+
+    db = _SqlCaptureDb()
+    # 绕过仓储初始化里的运行时补字段检查，本用例只验证目标查询 SQL 的城市过滤下推。
+    repository = object.__new__(LogisticsDataQaRepository)
+    repository.db = db  # type: ignore[assignment]
+
+    data = repository.hist_carrier_kpi_by_year(year=2025, city="常州")
+
+    assert data["total_shipment_mw"] == 300.0
+    assert len(data["items"]) == 2
+    assert len(db.calls) == 2
+    for sql, params in db.calls:
+        assert "city = :city" in sql
+        assert params["city"] == "常州"