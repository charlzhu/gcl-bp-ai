+            candidate = re.sub(r"^(?:年|今年|去年|上半年|下半年|全年|各|不同)", "", candidate).strip()
+            candidate = re.sub(r"(?:各|不同|各家|每家|每|全部|所有)$", "", candidate).strip()
+            candidate = candidate.rstrip("的")
