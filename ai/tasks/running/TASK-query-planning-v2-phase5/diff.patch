+class _FakeGrayLogRepository:
+    """测试用只读日志仓储，记录查询参数并返回固定 sys_query_log 行。"""
+
+    def __init__(self, rows: list[dict[str, Any]]) -> None:
+        self.rows = rows
+        self.calls: list[dict[str, Any]] = []
+
+    def list_query_logs_for_query_planning_gray(
+        self,
+        db: object,
+        *,
+        domain: str = "all",
+        limit: int = 200,
+        days: int = 7,
