+    file_name = upload_files[0].filename if upload_files else None
+    return ApiResponse.success(
+        _upload_failure_payload(
+            message="当前上传接口仅支持 business_type=plan_bom。",
+            file_name=file_name,
+            file_size=0,
+            next_action="请将 business_type 改为 plan_bom 后重新上传。",
+        ),
+        trace_id=trace_id,
+    )
