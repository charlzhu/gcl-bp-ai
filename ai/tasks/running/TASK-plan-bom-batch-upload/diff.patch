diff --git a/tests/business_acceptance/test_plan_bom_batch_upload_endpoint.py b/tests/business_acceptance/test_plan_bom_batch_upload_endpoint.py
new file mode 100644
index 0000000..7a68906
--- /dev/null
+++ b/tests/business_acceptance/test_plan_bom_batch_upload_endpoint.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+import asyncio
+from types import SimpleNamespace
+
+from backend.app.domains.plan_bom.api.endpoints.import_excel import upload_plan_bom_excel
+from backend.app.domains.plan_bom.schemas.import_excel import PlanBomImportReport
+
+
+class FakeUploadFile:
+    """用于直接调用 FastAPI endpoint 的最小上传文件桩。"""
+
+    def __init__(self, filename: str, content: bytes) -> None:
+        self.filename = filename
+        self._content = content
+
+    async def read(self) -> bytes:
+        """返回测试预置的文件内容。"""
+        return self._content
+
+
+class FakePlanBomImportService:
+    """记录导入调用并返回可预测报告，避免测试依赖真实 Excel 解析。"""
+
+    def __init__(self) -> None:
+        self.calls: list[tuple[str, bytes]] = []
+
+    def import_bytes(self, content: bytes, *, file_name: str, batch_id: str | None = None) -> PlanBomImportReport:
+        """模拟单文件入库成功报告。"""
+        self.calls.append((file_name, content))
+        return PlanBomImportReport(
+            batch_id=batch_id or f"batch-{len(self.calls)}",
+            status="success",
+            file_name=file_name,
+            file_hash=f"hash-{len(self.calls)}",
+            sheet_count=1,
+            header_count=len(self.calls),
+            material_line_count=len(content),
+            revision_count=0,
+            warning_count=0,
+            error_count=0,
+            persisted_business_data=True,
+        )
+
+
+def test_plan_bom_upload_endpoint_accepts_multiple_files_and_returns_batch_summary() -> None:
+    """后端 BOM 上传接口应兼容 files[] 批量上传，并返回逐文件结果与汇总。"""
+    request = SimpleNamespace(state=SimpleNamespace(trace_id="trace-batch-upload"))
+    service = FakePlanBomImportService()
+
+    response = asyncio.run(
+        upload_plan_bom_excel(
+            request=request,
+            file=None,
+            files=[FakeUploadFile("bom-a.xlsx", b"aaa"), FakeUploadFile("bom-b.xlsm", b"bb")],
+            business_type="plan_bom",
+            source="trial_run_ui",
+            overwrite=True,
+            remark="批量上传验收",
+            service=service,
+        )
+    )
+
+    payload = response.data
+    assert response.trace_id == "trace-batch-upload"
+    assert service.calls == [("bom-a.xlsx", b"aaa"), ("bom-b.xlsm", b"bb")]
+    assert payload["success"] is True
+    assert payload["total_files"] == 2
+    assert payload["success_count"] == 2
+    assert payload["failed_count"] == 0
+    assert payload["parsed_orders_count"] == 3
+    assert payload["parsed_materials_count"] == 5
+    assert [item["file_name"] for item in payload["items"]] == ["bom-a.xlsx", "bom-b.xlsm"]
+    assert all(item["success"] for item in payload["items"])
+
+
+def test_plan_bom_batch_upload_keeps_partial_failures_per_file() -> None:
+    """批量上传中某个文件格式不合法时，不应阻断其它合法 BOM 文件导入。"""
+    request = SimpleNamespace(state=SimpleNamespace(trace_id="trace-batch-partial"))
+    service = FakePlanBomImportService()
+
+    response = asyncio.run(
+        upload_plan_bom_excel(
+            request=request,
+            file=None,
+            files=[FakeUploadFile("bom-ok.xlsx", b"ok"), FakeUploadFile("readme.txt", b"not excel")],
+            business_type="plan_bom",
+            source="trial_run_ui",
+            overwrite=True,
+            remark=None,
+            service=service,
+        )
+    )
+
+    payload = response.data
+    assert service.calls == [("bom-ok.xlsx", b"ok")]
+    assert payload["success"] is False
+    assert payload["total_files"] == 2
+    assert payload["success_count"] == 1
+    assert payload["failed_count"] == 1
+    assert payload["items"][0]["success"] is True
+    assert payload["items"][1]["success"] is False
+    assert payload["items"][1]["file_name"] == "readme.txt"
+    assert "仅支持 .xls / .xlsx / .xlsm" in payload["items"][1]["message"]
