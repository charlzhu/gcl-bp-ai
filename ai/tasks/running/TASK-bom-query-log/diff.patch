+    @staticmethod
+    def _select_display_efficiency_segments(segments: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        """选择表格中展示的建议效率段。
+
+        参数：
+            segments: 推荐服务输出的候选效率段。
+
+        返回：
+            按效率从低到高排序后的前 2 个效率段，满足业务员“从最低效率开始展示”的要求。
+        """
+        return sorted(
