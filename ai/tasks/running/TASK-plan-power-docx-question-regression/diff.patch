+    @staticmethod
+    def _normalize_target_power_ratio(value: Any) -> dict[str, float]:
+        """校验并归一 LLM 候选目标功率比例。"""
+        if not isinstance(value, dict):
+            return {}
+        result: dict[str, float] = {}
+        for key, raw_ratio in value.items():
+            try:
+                power = float(key)
+                ratio = float(raw_ratio)
+            except (TypeError, ValueError):
+                continue
+            if ratio <= 0:
+                continue
