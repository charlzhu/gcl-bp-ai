+                nlu=nlu,
+                answer_summary=answer,
+                result_table=PlanBomTableSpec(columns=["功率档", "预测比例", "累计比例", "中心功率", "供应商"], rows=rows),
+                raw_result={
+                    "bom_config_resolution": resolution_payload,
+                    "power_prediction": prediction.to_dict(),
