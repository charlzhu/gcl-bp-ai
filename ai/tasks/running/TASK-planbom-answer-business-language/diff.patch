+            chunks: list[str] = []
+            for event in stream:
+                chunk = self._extract_delta_text(event)
+                if not chunk:
+                    continue
+                chunks.append(chunk)
+            streamed_answer = "".join(chunks).strip()
+            if not streamed_answer:
+                self._last_stream_source = "deterministic_fallback"
+                self._last_fallback_reason = "llm_empty_stream"
