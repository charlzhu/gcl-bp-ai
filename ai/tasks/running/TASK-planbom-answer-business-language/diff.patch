+            left_side = candidate_side
+            right_side = original_payload.right
+        return PlanBomCompareQueryRequest(
+            left=left_side,
+            right=right_side,
+            material_categories=original_payload.material_categories,
+            candidate_limit=original_payload.candidate_limit,
