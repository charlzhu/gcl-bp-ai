+
+    def __init__(
+        self,
+        *,
+        enabled: bool | None = None,
+        base_url: str | None = None,
+        api_key: str | None = None,
+        model: str | None = None,
+        client: Any | None = None,
+        timeout: float | None = None,
+    ) -> None:
