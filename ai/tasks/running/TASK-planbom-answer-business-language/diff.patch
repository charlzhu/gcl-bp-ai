+    def _answer_row_bindings_are_safe(self, answer: str, *, deterministic_payload: dict[str, Any]) -> bool:
+        """校验结构化行中的“名称-数值”绑定没有被 LLM 错配。
+
+        业务逻辑：
+            数字白名单只能保证 LLM 没有新增数字，但不能防止把“华东 120.5MW”说成
+            “华北 120.5MW”。因此只要主回答复述了某一行的指标数字，就要求同一语句
