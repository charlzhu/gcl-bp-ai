+    @staticmethod
+    def _can_expand_compare_candidates(
+        *,
+        nlu: PlanBomNluCandidate,
+        candidate_result: PlanBomCompareResponse,
+        candidates: list[PlanBomCandidate],
+    ) -> bool:
+        """判断 compare 候选态是否允许自动展开为多组对比。
+
