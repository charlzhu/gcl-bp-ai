+def test_business_power_recommendation_table_matches_sales_excel_export_columns(live_plan_bom_qa_service):
+    """供应商推荐明细表应按业务员 Excel 下载意见展示，隐藏匹配度并补 CTM/落档预估。
+
+    参数：
+        live_plan_bom_qa_service: 真实库 QA 服务 fixture。
+    返回值：
+        无；通过断言验证后端 table columns/rows，即前端下载 Excel 的真实数据源。
+    业务逻辑：智能助手 Excel 下载只导出 `presentation.table` 的可见列，因此此处直接
+        验证 QA 表头、建议效率段、CTM 值、落档比例预估和解释文案。
+    """
+
+    question = "NT12R/66GDF（深圳建融-2025-01073）0.24焊带+双镀玻璃+300/200线长，北德基准，615功率，各个供应商厂家从什么电池效率可以满足"
+
+    response = live_plan_bom_qa_service.ask(question, use_llm=False, trace_id="real-business-export-columns")
+
+    assert response.classification == "A"
+    assert response.status.code == "OK"
+    assert response.result_table.columns == [
+        "供应商",
+        "目标功率档",
+        "目标比例",
+        "预测比例",
+        "CTM 值",
+        "中心功率",
+        "建议效率段",
+        "落档比例预估",
+    ]
+    assert response.result_table.rows
+    assert "匹配度" not in response.result_table.columns
+    assert "差异" not in response.result_table.columns
+    assert "指标5" not in response.result_table.columns
+    assert "预测比例表示" not in response.answer_summary
+    assert "中心功率来自" not in response.answer_summary
+    assert "基准功率" not in response.answer_summary
+
+    first_raw_recommendation = response.raw_result["power_recommendation"]["recommendations"][0]
+    assert "score" in first_raw_recommendation
+    assert "target_diff" in first_raw_recommendation
+
+    for row in response.result_table.rows:
+        assert "匹配度" not in row
+        assert "差异" not in row
+        assert "指标5" not in row
+        assert isinstance(row["CTM 值"], str)
+        assert row["CTM 值"].endswith("%")
+        assert 90 < float(row["CTM 值"].rstrip("%")) < 110
+
+        segments = [item for item in str(row["建议效率段"]).split("、") if item]
+        assert len(segments) == 2
+        numeric_segments = [float(item.rstrip("%")) for item in segments]
+        assert numeric_segments == sorted(numeric_segments)
+
+        estimate = str(row["落档比例预估"])
+        assert estimate
+        assert "；" not in estimate
+        estimate_lines = [line for line in estimate.splitlines() if line.strip()]
+        assert len(estimate_lines) == len(segments)
+        assert all("→" in line and "615W" in line for line in estimate_lines)
+        assert all(segment.rstrip("%") in line for segment, line in zip(segments, estimate_lines))
+
