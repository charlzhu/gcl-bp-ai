+    @staticmethod
+    def _candidate_name_mismatch_text(question: str, candidates: list[dict[str, Any]]) -> str:
+        """识别用户输入的订单前缀是否未出现在候选 BOM 名称中。"""
+        if not question or not candidates:
+            return ""
+        # 业务常写“客户/项目—00106”；尾号候选过多时，将破折号前的项目词与候选名做只读比对。
