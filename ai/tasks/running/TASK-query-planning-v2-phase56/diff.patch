+            query_key="hist_mw_by_carrier",
+            metrics=["shipment_mw"],
+            dimensions=["carrier"],
+            filters={"year": 2025},
+        ),
+        status=LogisticsDataQaStatus(code="OK", message="查询成功", success=True),
+    )
+
