+    events = anyio.run(_collect_stream_events, response)
+    event_names = [event["event"] for event in events]
+    done_payload = events[-1]["data"]
+
+    assert event_names[:2] == ["meta", "meta"]
+    assert "delta" in event_names
+    assert event_names[-1] == "done"
+    assert service.questions == [("订单00104的玻璃规格是什么？", True, "stream-test-trace")]
+    assert done_payload["domain"] == "plan_bom"
+    assert done_payload["answer"] == "已查询订单00104的玻璃规格，共返回1条BOM材料。"
+    assert done_payload["data"]["presentation"]["answer"] == done_payload["answer"]
+    assert done_payload["data"]["result_table"]["rows"] == [{"订单号": "00104", "材料类别": "玻璃", "规格描述": "双玻测试规格"}]
+    assert done_payload["data"]["presentation"]["debug"]["stream_answer_source"] == "deterministic_fallback"
+    assert not service.error_logs
+
+
+def test_logistics_stream_endpoint_emits_delta_before_done_and_keeps_structured_payload() -> None:
+    """物流流式接口应复用确定性查询结果，并以 done 事件返回完整结构化数据。"""
+
+    service = _FakeLogisticsDataQaService()
+    response = logistics_data_qa_query_stream(
+        LogisticsDataQaQueryRequest(question="2024年江苏省各城市总费用排名前五？"),
+        _FakeRequest(),
+        service,
+    )
+
+    events = anyio.run(_collect_stream_events, response)
+    event_names = [event["event"] for event in events]
+    done_payload = events[-1]["data"]
+
+    assert event_names[:2] == ["meta", "meta"]
+    assert "delta" in event_names
+    assert event_names[-1] == "done"
+    assert service.questions == [("2024年江苏省各城市总费用排名前五？", "stream-test-trace")]
+    assert done_payload["domain"] == "logistics"
