+async def _collect_stream_events(response) -> list[dict[str, Any]]:  # noqa: ANN001
+    """收集 StreamingResponse 的 NDJSON 事件，供 endpoint 契约测试断言。"""
+
+    chunks: list[str] = []
+    async for item in response.body_iterator:
+        chunks.append(item.decode("utf-8") if isinstance(item, bytes) else item)
+    return [json.loads(line) for line in "".join(chunks).splitlines() if line.strip()]
