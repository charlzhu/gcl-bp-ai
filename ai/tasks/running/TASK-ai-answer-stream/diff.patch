+            result_payload = result.model_dump(mode="json")
+            yield build_json_line_event(
+                "meta",
+                {
+                    "trace_id": trace_id,
+                    "domain": "plan_bom",
+                    "stage": "deterministic_result_ready",
+                    "status_code": (result_payload.get("status") or {}).get("code"),
+                },
+            )
+            chunks: list[str] = []
+            for chunk in stream_service.stream_answer(
+                domain="plan_bom",
