+    @classmethod
+    def _collect_allowed_number_tokens(cls, response: PlanBomQaResponse) -> set[str]:
+        """收集计划 BOM 确定性结果中允许表达层复述的数字。
+
+        参数：
+            response: 确定性 QA 响应。
+
+        返回：
