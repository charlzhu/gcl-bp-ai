+    def create(self, **_: object):
+        """返回最小 completion 对象，模拟 LLM JSON 输出。"""
+        self.calls += 1
+        message = type("Message", (), {"content": json.dumps(self.payload, ensure_ascii=False)})()
+        choice = type("Choice", (), {"message": message})()
+        return type("Completion", (), {"choices": [choice]})()
+
