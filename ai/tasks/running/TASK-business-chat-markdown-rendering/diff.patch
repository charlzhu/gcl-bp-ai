+"""智能问答 Markdown 答案渲染验收。"""
+
+from __future__ import annotations
+
+import subprocess
+import textwrap
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+FRONTEND = ROOT / "frontend"
+FRONTEND_SRC = FRONTEND / "src"
+MARKDOWN_SOURCE = FRONTEND_SRC / "utils" / "businessMarkdown.ts"
+CHAT_PAGE = FRONTEND_SRC / "views" / "business-chat" / "BusinessChatPage.vue"
+
+
+def _compile_markdown_renderer(tmp_path: Path) -> Path:
+    """编译无框架依赖的 Markdown 渲染工具，便于用 Node 验证真实输出。"""
+    out_dir = tmp_path / "compiled"
+    out_dir.mkdir()
+    tsc = FRONTEND / "node_modules" / ".bin" / "tsc"
+    subprocess.run(
+        [
+            str(tsc),
+            str(MARKDOWN_SOURCE),
+            "--target",
+            "ES2020",
+            "--module",
+            "commonjs",
+            "--outDir",
+            str(out_dir),
+            "--skipLibCheck",
+            "--esModuleInterop",
+        ],
+        cwd=ROOT,
+        check=True,
+    )
+    return out_dir / "businessMarkdown.js"
+
+
+def test_business_markdown_renderer_formats_llm_answer_and_escapes_html(tmp_path: Path) -> None:
+    """LLM 返回的 Markdown 应被渲染为企业级正文，而不是在页面上露出 ** 或 - 前缀。"""
+    compiled_module = _compile_markdown_renderer(tmp_path)
+    harness = tmp_path / "markdown-renderer.cjs"
+    harness.write_text(
+        textwrap.dedent(
+            f"""
+            const {{ renderBusinessMarkdown }} = require({str(compiled_module)!r});
+            const markdown = [
+              '针对订单 **NT12R/66GDF（深圳建融-2025-01073）**，各供应商满足该功率档位所需的**电池效率段已明确推荐**。',
+              '',
+              '综合 CTM 值和中心功率来看：',
+              '- **中润** 为当前匹配度最高的供应商。',
+              '- 其余供应商主要集中在 **25.3%~25.6%** 区间。',
+              '',
+              '<script>alert(1)</script>'
+            ].join('\\n');
+            const html = renderBusinessMarkdown(markdown);
+            const required = [
+              '<p>',
+              '<strong>NT12R/66GDF（深圳建融-2025-01073）</strong>',
+              '<strong>电池效率段已明确推荐</strong>',
+              '<ul>',
+              '<li><strong>中润</strong> 为当前匹配度最高的供应商。</li>',
+              '<strong>25.3%~25.6%</strong>',
+              '&lt;script&gt;alert(1)&lt;/script&gt;'
+            ];
+            for (const token of required) {{
+              if (!html.includes(token)) {{
+                throw new Error(`Markdown 渲染缺少片段: ${{token}}\\n实际输出: ${{html}}`);
+              }}
+            }}
+            if (html.includes('**') || html.includes('<script>') || html.includes('</script>')) {{
+              throw new Error(`Markdown 或危险 HTML 未正确处理: ${{html}}`);
+            }}
+            """
+        ),
+        encoding="utf-8",
+    )
+    subprocess.run(["node", str(harness)], cwd=ROOT, check=True)
+
+
+def test_business_chat_renders_assistant_markdown_in_streaming_and_final_answers() -> None:
+    """智能问答页应把助手 Markdown 用受控 HTML 渲染，用户消息仍保持纯文本。"""
+    chat = CHAT_PAGE.read_text(encoding="utf-8")
+    template = chat.split("<script setup", 1)[0]
+
+    assert "renderBusinessMarkdown" in chat
+    assert "v-html=\"renderBusinessMarkdown(message.presentation.answer)\"" in template
+    assert "v-html=\"renderBusinessMarkdown(message.content)\"" in template
+    assert "message.role === 'assistant'" in template
+    assert "{{ message.presentation.answer }}" not in template
+    assert "{{ message.content }}" in template
