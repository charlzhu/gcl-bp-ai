+    assert "X-Plan-Power-Admin-Token" not in api
+    assert "adminToken" not in api
+    assert "multipart/form-data" in api
+    assert "onUploadProgress" in api
+    assert "Math.round" in api
+    assert "options.onUploadProgress" in api
