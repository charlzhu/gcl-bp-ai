+                value=summary.total_logs,
+                unit="条",
+                status="neutral",
+                description="本次灰度报表读取的 sys_query_log 样本数。",
+            ),
+            QueryPlanningV2GrayVisualizationKpiCard(
+                key="shadow_coverage_rate",
