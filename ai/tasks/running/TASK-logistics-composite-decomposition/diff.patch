+def test_r39_explicit_power_configuration_is_not_blocked_by_tail_candidates(plan_bom_qa_service: PlanBomQaService) -> None:
+    """R39：显式材料配置完整时，不应被不可靠订单尾号多候选阻断 no-BOM 功率推荐。"""
+
+    question = "创维210N—00106，0.24+0.26焊带+高透玻璃+间隙铝膜+300/200线长，计量院基准，单一需求720功率，各个供应商厂家从什么电池效率可以满足"
+    response = plan_bom_qa_service.ask(question, use_llm=False, trace_id="business-feedback-r39")
+
+    assert response.status.code == "OK", response.model_dump(mode="json")
+    assert response.classification == "A"
+    assert response.nlu.intent == "plan_power_supplier_recommendation"
+    assert response.result_table.rows
+    assert response.raw_result["bom_config_resolution"]["order_no"] is None
+    assert any("未确认订单候选" in warning or "忽略" in warning for warning in response.warnings)
+
