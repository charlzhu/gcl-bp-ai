+    def test_catalog_still_supports_metrics(self) -> None:
+        """新增能力后，指标注册表仍然正常。"""
+        catalog = BusinessSemanticCatalog()
+        from backend.app.domains.semantic_catalog.schema import SemanticMetric
+
+        metric = SemanticMetric(
