+                    "ytd_by_published_months",
+                    "period_end_inventory_snapshot",
+                    "explicit_invoice_metric",
+                ]
+            }
+        )
+    )
+
+    assert result.ok is True, result.error_codes
+    assert result.normalized_plan is not None
