+++    if semantics == "month":
+++        payload["month"] = period.month
+++    elif semantics == "quarter":
+++        payload["quarter"] = period.quarter
+++    elif semantics == "ytd":
+++        payload["months"] = _months_from_query_period(period)
+++    else:
+++        payload["months"] = _months_from_query_period(period)
+++    return payload
