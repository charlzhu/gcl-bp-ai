+++def _build_sqlplan_candidate_payload(
+++    *,
+++    query_key: str,
+++    metrics: list[str],
+++    dimensions: list[str],
+++    period_type: str,
+++    year: int,
+++    month: int | None = None,
+++    quarter: int | None = None,
+++    month_filter_values: list[int] | None = None,
