+++def _redaction_guard_candidate_payload() -> dict[str, Any]:
+++    """构造含 SQL-like 噪声的 candidate，验证 validator fail-closed 与 artifact 脱敏。"""
+++
+++    payload = _build_sqlplan_candidate_payload(
