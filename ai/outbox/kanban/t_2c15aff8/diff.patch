--- /dev/null
+++ b/tmp/hermes/generate_m15_diff.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Generate a task-scoped diff patch for M1.5 artifacts without touching unrelated dirty files."""
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "ai" / "outbox" / "kanban" / "t_2c15aff8" / "diff.patch"
+TRACKED = [
+    "backend/requirements.txt",
+    "docs/SAP_MID_ORACLE_SMOKE_TEST_REPORT.md",
+]
+UNTRACKED_OR_ARTIFACTS = [
+    "tmp/hermes/sap_mid_oracle_smoke.py",
+    "tmp/hermes/sap_mid_oracle_client_probe.py",
+    "tmp/hermes/m15_secret_scan.py",
+    "tmp/hermes/run_m15_acceptance.py",
+    "tmp/hermes/generate_m15_diff.py",
+    "ai/outbox/kanban/t_2c15aff8/oracle_smoke_safe_result.json",
+    "ai/outbox/kanban/t_2c15aff8/smoke-result-sanitized.json",
+    "ai/outbox/kanban/t_2c15aff8/oracle_client_probe_safe_result.json",
+    "ai/outbox/kanban/t_2c15aff8/client-probe.stdout.log",
+    "ai/outbox/kanban/t_2c15aff8/pip-check.log",
+    "ai/outbox/kanban/t_2c15aff8/py-compile.log",
+    "ai/outbox/kanban/t_2c15aff8/py-compile.status",
+    "ai/outbox/kanban/t_2c15aff8/secret-scan.log",
+    "ai/outbox/kanban/t_2c15aff8/secret-scan.stdout.log",
+    "ai/outbox/kanban/t_2c15aff8/secret-scan.status",
+    "ai/outbox/kanban/t_2c15aff8/test.log",
+    "ai/outbox/kanban/t_2c15aff8/final-acceptance.md",
+]
+
+
+def run(args: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(args, cwd=str(ROOT), text=True, capture_output=True, check=False)
+
+
+def main() -> int:
+    parts: list[str] = []
+    tracked_existing = [p for p in TRACKED if (ROOT / p).exists()]
+    if tracked_existing:
+        proc = run(["git", "diff", "--", *tracked_existing])
+        parts.append(proc.stdout)
+        if proc.returncode not in (0, 1):
+            parts.append(f"\n# git diff returned {proc.returncode}\n{proc.stderr}\n")
+    for rel in UNTRACKED_OR_ARTIFACTS:
+        path = ROOT / rel
+        if not path.exists() or not path.is_file():
+            continue
+        proc = run(["git", "diff", "--no-index", "--", "/dev/null", rel])
+        if proc.stdout:
+            parts.append(proc.stdout)
+        elif proc.stderr:
+            parts.append(f"\n# no-index stderr for {rel}:\n{proc.stderr}\n")
+    OUT.write_text("\n".join(part for part in parts if part), encoding="utf-8")
+    print(f"diff_path={OUT.relative_to(ROOT)}")
+    print(f"diff_bytes={OUT.stat().st_size}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

