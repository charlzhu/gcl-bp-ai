new file mode 100644
index 0000000..3978d67
--- /dev/null
+++ b/tmp/hermes/m15_secret_scan.py
@@ -0,0 +1,113 @@
+"""Secret leak scanner for M1.5 smoke-test artifacts.
+
+读取 backend/.env 中敏感连接值，但只输出是否命中，不输出真实值。
+短值（例如很短的 service 名）不做裸值全文匹配，避免把普通词误判为泄漏；
+此类值仍会参与 host/service、host:port/service 等组合片段扫描。
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+ENV_PATH = ROOT / "backend" / ".env"
+SENSITIVE_KEYS = [
+    "SAP_ORACLE_HOST",
+    "SAP_ORACLE_PORT",
+    "SAP_ORACLE_SERVICE",
+    "SAP_ORACLE_USER",
+    "SAP_ORACLE_PASSWORD",
+    "SAP_ORACLE_OWNER",
+]
+RAW_LITERAL_KEYS = {
+    "SAP_ORACLE_HOST",
+    "SAP_ORACLE_SERVICE",
+    "SAP_ORACLE_USER",
+    "SAP_ORACLE_PASSWORD",
+}
+MIN_LITERAL_LENGTH = 4
+
+
+def load_config_values() -> dict[str, str]:
+    values: dict[str, str] = {}
+    if not ENV_PATH.exists():
+        return values
+    for raw in ENV_PATH.read_text(encoding="utf-8", errors="replace").splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        key = key.strip()
+        value = value.strip().strip('"').strip("'")
+        if key in SENSITIVE_KEYS:
+            values[key] = value
+    return values
+
+
+def build_needles(values: dict[str, str]) -> tuple[dict[str, str], dict[str, str]]:
+    literal_needles: dict[str, str] = {}
+    for key in RAW_LITERAL_KEYS:
+        value = values.get(key, "")
+        if len(value) >= MIN_LITERAL_LENGTH:
+            literal_needles[f"literal:{key}"] = value
+
+    host = values.get("SAP_ORACLE_HOST", "")
+    port = values.get("SAP_ORACLE_PORT", "")
+    service = values.get("SAP_ORACLE_SERVICE", "")
+    user = values.get("SAP_ORACLE_USER", "")
+    password = values.get("SAP_ORACLE_PASSWORD", "")
+    compound_needles: dict[str, str] = {}
+    if host and port:
+        compound_needles["compound:host_port"] = f"{host}:{port}"
+    if host and service:
+        compound_needles["compound:host_service"] = f"{host}/{service}"
+    if host and port and service:
+        compound_needles["compound:host_port_service"] = f"{host}:{port}/{service}"
+    if user and password:
+        compound_needles["compound:user_password_pair"] = f"{user}/{password}"
+    return literal_needles, compound_needles
+
+
+def main(argv: list[str]) -> int:
+    values = load_config_values()
+    literal_needles, compound_needles = build_needles(values)
+    hits: list[dict[str, str]] = []
+    scanned_files = 0
+    for file_arg in argv[1:]:
+        path = Path(file_arg)
+        if not path.is_absolute():
+            path = ROOT / path
+        if not path.exists() or not path.is_file():
+            continue
+        scanned_files += 1
+        text = path.read_text(encoding="utf-8", errors="replace")
+        for label, value in {**literal_needles, **compound_needles}.items():
+            if value and value in text:
+                kind, key = label.split(":", 1)
+                hits.append({"file": str(path.relative_to(ROOT)), "kind": kind, "key": key})
+
+    literal_scan_status = {}
+    for key in sorted(RAW_LITERAL_KEYS):
+        value = values.get(key, "")
+        if not value:
+            literal_scan_status[key] = "missing_or_empty"
+        elif len(value) < MIN_LITERAL_LENGTH:
+            literal_scan_status[key] = "skipped_short_value_compound_only"
+        else:
+            literal_scan_status[key] = "checked"
+
+    result = {
+        "files_scanned": scanned_files,
+        "sensitive_keys_present": sorted(key for key, value in values.items() if value),
+        "literal_scan_status": literal_scan_status,
+        "compound_fragments_checked": sorted(compound_needles.keys()),
+        "secret_hits": hits,
+        "status": "pass" if not hits else "fail",
+    }
+    print(json.dumps(result, ensure_ascii=False, indent=2))
+    return 0 if not hits else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))

