+    env["HERMES_ORACLE_TCP_TIMEOUT_SECONDS"] = "10"
+    smoke_cmd = ["backend/.venv/bin/python", "tmp/hermes/sap_mid_oracle_smoke.py"]
+    smoke = run(smoke_cmd, env=env, timeout=150)
+    append_command_log(lines, "read-only Oracle smoke probe", smoke_cmd, smoke)
+
+    client_cmd = ["backend/.venv/bin/python", "tmp/hermes/sap_mid_oracle_client_probe.py"]
+    client = run(client_cmd, timeout=120)
+    CLIENT_STDOUT_LOG.write_text(client.stdout, encoding="utf-8")
+    append_command_log(lines, "thick-mode Oracle Client probe", client_cmd, client)
+
+    pip_cmd = ["backend/.venv/bin/python", "-m", "pip", "check"]
+    pip = run(pip_cmd, timeout=120)
+    PIP_CHECK_LOG.write_text((pip.stdout + pip.stderr), encoding="utf-8")
+    append_command_log(lines, "pip dependency consistency check", pip_cmd, pip)
+
+    lines.extend([
+        "",
+        "## Result interpretation",
+        "- Smoke probe exit_code=0 means all required M1.5 SQL checks passed; exit_code=2 means M2 remains blocked and details are in sanitized JSON.",
+        "- pip check is recorded for environment visibility; current known conflicts are unrelated to oracledb unless the log says otherwise.",
+        "- All outputs above are produced by scripts that redact connection values and only report key presence/error codes.",
+    ])
+    TEST_LOG.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    print(f"wrote {TEST_LOG.relative_to(ROOT)}")
+    print(f"smoke_rc={smoke.returncode}")
+    print(f"client_probe_rc={client.returncode}")
+    print(f"pip_check_rc={pip.returncode}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

