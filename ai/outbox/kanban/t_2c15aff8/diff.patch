+from __future__ import annotations
+
+import contextlib
+import glob
+import importlib.util
+import json
+import os
+import re
+import socket
+import subprocess
+import sys
+import time
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[2]
+OUTDIR = ROOT / "ai" / "outbox" / "kanban" / "t_2c15aff8"
+RESULT_PATH = OUTDIR / "oracle_smoke_safe_result.json"
+SANITIZED_PATH = OUTDIR / "smoke-result-sanitized.json"
+VIEW_NAMES = ["V_HF_SAP_INOUT_DAILY", "V_SAP_HFFN_CRKLSZ"]
+REQUIRED_KEYS = [
+    "SAP_ORACLE_HOST",
+    "SAP_ORACLE_PORT",
+    "SAP_ORACLE_SERVICE",
+    "SAP_ORACLE_USER",
+    "SAP_ORACLE_PASSWORD",
+    "SAP_ORACLE_OWNER",
+]
+SENSITIVE_KEYS = {
+    "SAP_ORACLE_HOST",
+    "SAP_ORACLE_SERVICE",
+    "SAP_ORACLE_USER",
+    "SAP_ORACLE_PASSWORD",
+}
+IDENTIFIER_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_$#]{0,127}$")
+ERROR_CODE_RE = re.compile(r"\b(?:DPY|DPI|ORA)-\d{4,5}\b")
+
+
+def now_cst() -> str:
+    """返回用于报告的本地时间字符串。"""
+    return time.strftime("%Y-%m-%d %H:%M:%S %Z")
+
+
+def read_env_file() -> dict[str, str]:
+    """读取 backend/.env 中的 Oracle 配置；只在内存使用，绝不打印真实值。"""
+    values: dict[str, str] = {}
+    env_path = ROOT / "backend" / ".env"
+    if env_path.exists():
+        for raw_line in env_path.read_text(encoding="utf-8", errors="ignore").splitlines():
+            line = raw_line.strip()
+            if not line or line.startswith("#") or "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            key = key.strip()
+            if key in REQUIRED_KEYS:
+                values[key] = value.strip().strip('"').strip("'")
+    for key in REQUIRED_KEYS:
+        if os.environ.get(key):
+            values[key] = os.environ[key]
+    return values
+
+
+def safe_codes(exc: BaseException | str) -> list[str]:
+    """从异常文本中提取 Oracle/python-oracledb 错误码，避免输出连接串。"""
+    return sorted(set(ERROR_CODE_RE.findall(str(exc))))
+
+
+def safe_error_summary(exc: BaseException) -> dict[str, Any]:
+    """只输出错误类型和错误码；不输出 host/user/password/DSN。"""
+    return {
+        "error_type": type(exc).__name__,
+        "codes": safe_codes(exc),
+    }
+
+
+def safe_bool_presence(values: dict[str, str]) -> dict[str, str]:
+    """将配置值脱敏为 present/missing。"""
+    return {key: "present" if values.get(key) else "missing" for key in REQUIRED_KEYS}
+
+
+def valid_identifier(name: str | None) -> bool:
+    """校验 Oracle owner/view 标识符，禁止拼接异常输入。"""
+    return bool(name and IDENTIFIER_RE.fullmatch(name))
+
+
+def child_payload(mode: str) -> dict[str, Any]:
+    """子进程执行单一连接模式，避免 thin/thick 模式互相污染。"""
+    values = read_env_file()
+    started = time.perf_counter()
+    try:
+        import oracledb  # type: ignore[import-not-found]
+
+        host = values["SAP_ORACLE_HOST"]
+        port = int(values.get("SAP_ORACLE_PORT") or "1521")
+        dsn = oracledb.makedsn(host, port, service_name=values["SAP_ORACLE_SERVICE"])
+        if mode == "thick":
+            init_info = init_thick_client(oracledb)
+            if not init_info.get("ok"):
+                return {
+                    "mode": mode,
+                    "ok": False,
+                    "elapsed_ms": elapsed_ms(started),
+                    "client_init": init_info,
+                }
+        conn = oracledb.connect(
+            user=values["SAP_ORACLE_USER"],
+            password=values["SAP_ORACLE_PASSWORD"],
+            dsn=dsn,
+        )
+        try:
+            checks = run_readonly_checks(conn, values)
+        finally:
+            with contextlib.suppress(Exception):
+                conn.close()
+        ok = bool(checks.get("select_1_from_dual", {}).get("ok")) and all(
+            item.get("ok") for item in checks.get("view_counts", {}).values()
+        ) and all(item.get("ok") for item in checks.get("view_samples", {}).values())
+        return {
+            "mode": mode,
+            "ok": ok,
+            "elapsed_ms": elapsed_ms(started),
+            "sql_checks": checks,
+            "client_init": {"ok": True} if mode == "thick" else None,
+        }
+    except Exception as exc:  # noqa: BLE001
+        return {
+            "mode": mode,
+            "ok": False,
+            "elapsed_ms": elapsed_ms(started),
+            **safe_error_summary(exc),
+        }
+
+
+def elapsed_ms(started: float) -> int:
+    """计算毫秒耗时。"""
+    return int((time.perf_counter() - started) * 1000)
+
+
+def init_thick_client(oracledb: Any) -> dict[str, Any]:
+    """尝试初始化 thick 模式；候选路径只用于内部，不写入报告。"""
+    attempts: list[dict[str, Any]] = []
+    candidates = thick_client_candidates()
+    attempt_specs: list[tuple[str, str | None]] = [("default", None)]
+    attempt_specs.extend(("candidate", candidate) for candidate in candidates)
+    for attempt_no, (source, lib_dir) in enumerate(attempt_specs, start=1):
+        try:
+            if lib_dir:
+                oracledb.init_oracle_client(lib_dir=lib_dir)
+            else:
+                oracledb.init_oracle_client()
+            return {
+                "ok": True,
+                "attempt_no": attempt_no,
+                "source": source,
+                "candidate_count": len(candidates),
+            }
+        except Exception as exc:  # noqa: BLE001
+            attempts.append(
+                {
+                    "attempt_no": attempt_no,
+                    "source": source,
+                    "ok": False,
+                    **safe_error_summary(exc),
+                }
+            )
+    return {"ok": False, "candidate_count": len(candidates), "attempts": attempts}
+
+
+def thick_client_candidates() -> list[str]:
+    """查找可能的 Oracle Instant Client 目录；不返回到终端输出。"""
+    raw_candidates: list[str] = []
+    for key in ("SAP_ORACLE_CLIENT_LIB_DIR", "ORACLE_CLIENT_LIB_DIR"):
+        if os.environ.get(key):
+            raw_candidates.append(os.environ[key])
+    if os.environ.get("ORACLE_HOME"):
+        raw_candidates.append(str(Path(os.environ["ORACLE_HOME"]) / "lib"))
+    raw_candidates.extend(glob.glob("/opt/oracle/instantclient*"))
+    raw_candidates.extend(glob.glob(str(Path.home() / "instantclient*")))
+    raw_candidates.extend(glob.glob(str(Path.home() / "Downloads" / "instantclient*")))
+    raw_candidates.extend(["/opt/homebrew/lib", "/usr/local/lib"])
+
+    found: list[str] = []
+    seen: set[str] = set()
+    for candidate in raw_candidates:
+        if not candidate:
+            continue
+        path = Path(candidate).expanduser()
+        key = str(path)
+        if key in seen or not path.exists() or not path.is_dir():
+            continue
+        seen.add(key)
+        if (path / "libclntsh.dylib").exists() or list(path.glob("libclntsh.dylib*")):
+            found.append(key)
+    return found
+
+
+def run_readonly_checks(conn: Any, values: dict[str, str]) -> dict[str, Any]:
+    """执行只读 smoke SQL：dual、连接摘要、字段结构、count、小样本。"""
+    owner = values.get("SAP_ORACLE_OWNER", "")
+    checks: dict[str, Any] = {
+        "owner_identifier_valid": valid_identifier(owner),
+        "select_1_from_dual": None,
+        "session_summary": None,
+        "views_registered": None,
+        "columns": None,
+        "view_counts": {},
+        "view_samples": {},
+    }
+    if not checks["owner_identifier_valid"]:
+        checks["owner_error"] = "SAP_ORACLE_OWNER is not a safe Oracle identifier"
+        return checks
+
+    cur = conn.cursor()
+    try:
+        cur.execute("SELECT 1 FROM dual")
+        row = cur.fetchone()
+        checks["select_1_from_dual"] = {"ok": bool(row and row[0] == 1), "row_count": 1}
+
+        cur.execute(
+            "SELECT SYS_CONTEXT('USERENV', 'SERVICE_NAME'), "
+            "SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'), USER FROM dual"
+        )
+        session_row = cur.fetchone()
+        checks["session_summary"] = {
+            "ok": session_row is not None,
+            "service_name_present": bool(session_row and session_row[0]),
+            "current_schema_present": bool(session_row and session_row[1]),
+            "login_user_redacted": bool(session_row and session_row[2]),
+        }
+
+        cur.execute(
+            "SELECT owner, view_name FROM all_views "
+            "WHERE view_name IN (:v1, :v2) ORDER BY owner, view_name",
+            v1=VIEW_NAMES[0],
+            v2=VIEW_NAMES[1],
+        )
+        views = cur.fetchall()
+        checks["views_registered"] = {
+            "ok": len(views) >= 2,
+            "row_count": len(views),
+            "view_names": [row[1] for row in views],
+            "owners_redacted": True,
+        }
+
+        cur.execute(
+            "SELECT owner, table_name, column_name, data_type, data_length, nullable "
+            "FROM all_tab_columns "
+            "WHERE owner = :owner AND table_name IN (:v1, :v2) "
+            "ORDER BY table_name, column_id",
+            owner=owner.upper(),
+            v1=VIEW_NAMES[0],
+            v2=VIEW_NAMES[1],
+        )
+        column_rows = cur.fetchall()
+        columns_by_view: dict[str, list[dict[str, Any]]] = {view: [] for view in VIEW_NAMES}
+        for _owner, table_name, column_name, data_type, data_length, nullable in column_rows:
+            columns_by_view.setdefault(table_name, []).append(
+                {
+                    "column_name": column_name,
+                    "data_type": data_type,
+                    "data_length": data_length,
+                    "nullable": nullable,
+                }
+            )
+        checks["columns"] = {
+            "ok": all(len(columns_by_view.get(view, [])) > 0 for view in VIEW_NAMES),
+            "column_count_by_view": {view: len(columns_by_view.get(view, [])) for view in VIEW_NAMES},
+            "columns_by_view": columns_by_view,
+        }
+
+        for view in VIEW_NAMES:
+            if not valid_identifier(view):
+                checks["view_counts"][view] = {"ok": False, "error": "invalid view identifier"}
+                checks["view_samples"][view] = {"ok": False, "error": "invalid view identifier"}
+                continue
+            qualified = f"{owner}.{view}"
+            try:
+                cur.execute(f"SELECT COUNT(*) FROM {qualified}")
+                count_row = cur.fetchone()
+                checks["view_counts"][view] = {"ok": True, "count": int(count_row[0])}
+            except Exception as exc:  # noqa: BLE001
+                checks["view_counts"][view] = {"ok": False, **safe_error_summary(exc)}
+            try:
+                cur.execute(f"SELECT * FROM {qualified} WHERE ROWNUM <= 5")
+                sample_rows = cur.fetchall()
+                checks["view_samples"][view] = {
+                    "ok": True,
+                    "row_count": len(sample_rows),
+                    "column_count": len(cur.description or []),
+                    "column_names": [desc[0] for desc in (cur.description or [])],
+                    "sample_values_redacted": True,
+                }
+            except Exception as exc:  # noqa: BLE001
+                checks["view_samples"][view] = {"ok": False, **safe_error_summary(exc)}
+    finally:
+        with contextlib.suppress(Exception):
+            cur.close()
+    return checks
+
+
+def run_child(mode: str) -> dict[str, Any]:
+    """用子进程执行 thin/thick，保证模式独立。"""
+    env = os.environ.copy()
+    env["HERMES_ORACLE_SMOKE_CHILD"] = mode
+    proc = subprocess.run(
+        [sys.executable, str(Path(__file__).resolve())],
+        cwd=str(ROOT),
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=90,
+        check=False,
+    )
+    if proc.returncode != 0:
+        return {"mode": mode, "ok": False, "child_returncode": proc.returncode, "codes": safe_codes(proc.stderr)}
+    try:
+        return json.loads(proc.stdout)
+    except json.JSONDecodeError:
+        return {"mode": mode, "ok": False, "child_json_error": True, "codes": safe_codes(proc.stderr + proc.stdout)}
+
+
+def tcp_probe(values: dict[str, str]) -> dict[str, Any] | None:
+    """只做 TCP 连通性检查，不输出地址。"""
+    if not values.get("SAP_ORACLE_HOST") or not values.get("SAP_ORACLE_PORT"):
+        return None
+    timeout_seconds = float(os.environ.get("HERMES_ORACLE_TCP_TIMEOUT_SECONDS", "10"))
+    started = time.perf_counter()
+    try:
+        with socket.create_connection((values["SAP_ORACLE_HOST"], int(values["SAP_ORACLE_PORT"])), timeout=timeout_seconds):
+            return {"ok": True, "elapsed_ms": elapsed_ms(started), "timeout_seconds": timeout_seconds}
+    except Exception as exc:  # noqa: BLE001
+        return {"ok": False, "elapsed_ms": elapsed_ms(started), "timeout_seconds": timeout_seconds, **safe_error_summary(exc)}
+
+
+def summarize_attempts(attempts: list[dict[str, Any]]) -> dict[str, Any]:
+    """生成给终端/报告使用的脱敏摘要。"""
+    connected = next((attempt for attempt in attempts if attempt.get("ok")), None)
+    if connected:
+        sql_checks = connected.get("sql_checks") or {}
+        m2_ready = bool(
+            sql_checks.get("select_1_from_dual", {}).get("ok")
+            and sql_checks.get("columns", {}).get("ok")
+            and all(item.get("ok") for item in sql_checks.get("view_counts", {}).values())
+            and all(item.get("ok") for item in sql_checks.get("view_samples", {}).values())
+        )
+        return {
+            "status": "passed" if m2_ready else "partial",
+            "m2_ready": m2_ready,
+            "connection_status": "pass",
+            "successful_mode": connected.get("mode"),
+            "sql_checks": sql_checks,
+            "block_reason": None if m2_ready else "Oracle session established but one or more required readonly SQL checks failed",
+        }
+    thin_codes = next((attempt.get("codes") for attempt in attempts if attempt.get("mode") == "thin"), []) or []
+    thick = next((attempt for attempt in attempts if attempt.get("mode") == "thick"), {})
+    thick_codes = thick.get("codes") or []
+    if thick.get("client_init") and not thick["client_init"].get("ok"):
+        thick_codes = sorted(
+            set(
+                code
+                for item in thick["client_init"].get("attempts", [])
+                for code in item.get("codes", [])
+            )
+        )
+    return {
+        "status": "blocked",
+        "m2_ready": False,
+        "connection_status": "fail",
+        "sql_checks": None,
+        "block_reason": "Oracle session was not established; "
+        f"thin codes={thin_codes or ['unknown']}; thick codes={thick_codes or ['unknown']}",
+    }
+
+
+def write_outputs(result: dict[str, Any]) -> None:
+    """写入完整脱敏 JSON 与面向汇报的简版 JSON。"""
+    OUTDIR.mkdir(parents=True, exist_ok=True)
+    RESULT_PATH.write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")
+    sanitized = {
+        "executed_at": result["executed_at"],
+        "scope": "read_only_oracle_smoke",
+        "security": result["security"],
+        "config_presence": result["config_presence"],
+        "dependency": {
+            "oracledb_import": {
+                "status": "pass" if result["dependency"].get("oracledb_importable") else "missing",
+                "version": result["dependency"].get("oracledb_version"),
+            },
+            "cx_Oracle_import": {
+                "status": "present" if result["dependency"].get("cx_Oracle_importable") else "missing_not_used"
+            },
+        },
+        "tcp_connect": {"status": "pass" if result.get("network_probe", {}).get("ok") else "fail"},
+        "connection_status": result["connection_status"],
+        "attempts": [sanitize_attempt_for_report(item) for item in result.get("connection_attempts", [])],
+        "select_1_from_dual": summarize_sql_check(result, "select_1_from_dual"),
+        "view_columns": summarize_columns(result),
+        "view_counts": summarize_view_dict(result, "view_counts"),
+        "view_samples": summarize_view_dict(result, "view_samples"),
+        "status": result["status"],
+        "m2_ready": result["m2_ready"],
+        "blocker": result.get("block_reason"),
+    }
+    SANITIZED_PATH.write_text(json.dumps(sanitized, ensure_ascii=False, indent=2), encoding="utf-8")
+
+
+def sanitize_attempt_for_report(item: dict[str, Any]) -> dict[str, Any]:
+    """压缩连接尝试详情，保留错误码但去掉路径和连接元信息。"""
+    data = {
+        "mode": item.get("mode"),
+        "status": "pass" if item.get("ok") else "fail",
+        "elapsed_ms": item.get("elapsed_ms"),
+    }
+    if item.get("codes"):
+        data["codes"] = item.get("codes")
+    if item.get("client_init"):
+        init = item["client_init"]
+        data["client_init"] = {
+            "status": "pass" if init.get("ok") else "fail",
+            "candidate_count": init.get("candidate_count", 0),
+            "codes": sorted(set(code for attempt in init.get("attempts", []) for code in attempt.get("codes", []))),
+        }
+    return data
+
+
+def sql_checks(result: dict[str, Any]) -> dict[str, Any]:
+    """获取成功连接模式下的 SQL 检查结果。"""
+    for attempt in result.get("connection_attempts", []):
+        if attempt.get("sql_checks"):
+            return attempt["sql_checks"]
+    return {}
+
+
+def summarize_sql_check(result: dict[str, Any], key: str) -> str:
+    """将 SQL 检查状态转为报告短语。"""
+    checks = sql_checks(result)
+    if not checks:
+        return "not_executed_no_oracle_session"
+    item = checks.get(key)
+    if not item:
+        return "not_executed"
+    return "pass" if item.get("ok") else "fail"
+
+
+def summarize_columns(result: dict[str, Any]) -> Any:
+    """字段结构验证摘要。"""
+    checks = sql_checks(result)
+    if not checks:
+        return "not_executed_no_oracle_session"
+    columns = checks.get("columns") or {}
+    return {
+        "status": "pass" if columns.get("ok") else "fail",
+        "column_count_by_view": columns.get("column_count_by_view", {}),
+    }
+
+
+def summarize_view_dict(result: dict[str, Any], key: str) -> Any:
+    """count / sample 的逐视图验证摘要。"""
+    checks = sql_checks(result)
+    if not checks:
+        return "not_executed_no_oracle_session"
+    items = checks.get(key) or {}
+    summary: dict[str, Any] = {}
+    for view, item in items.items():
+        view_summary = {"status": "pass" if item.get("ok") else "fail"}
+        if "count" in item:
+            view_summary["count"] = item["count"]
+        if "row_count" in item:
+            view_summary["row_count"] = item["row_count"]
+        if "column_count" in item:
+            view_summary["column_count"] = item["column_count"]
+        if item.get("codes"):
+            view_summary["codes"] = item["codes"]
+        summary[view] = view_summary
+    return summary
+
+
+def main() -> int:
+    child_mode = os.environ.get("HERMES_ORACLE_SMOKE_CHILD")
+    if child_mode:
+        print(json.dumps(child_payload(child_mode), ensure_ascii=False))
+        return 0
+
+    values = read_env_file()
+    missing = [key for key in REQUIRED_KEYS if not values.get(key)]
+    dependency = {
+        "oracledb_importable": importlib.util.find_spec("oracledb") is not None,
+        "cx_Oracle_importable": importlib.util.find_spec("cx_Oracle") is not None,
+        "oracledb_version": None,
+    }
+    if dependency["oracledb_importable"]:
+        import oracledb  # type: ignore[import-not-found]
+
+        dependency["oracledb_version"] = getattr(oracledb, "__version__", None)
+
+    result: dict[str, Any] = {
+        "executed_at": now_cst(),
+        "scope": "read-only SAP MID Oracle smoke test; no Oracle writes; no unbounded table export; no real host/user/password/DSN output",
+        "required_config_keys": REQUIRED_KEYS,
+        "config_presence": safe_bool_presence(values),
+        "dependency": dependency,
+        "network_probe": None,
+        "connection_attempts": [],
+        "security": {
+            "no_oracle_writes": True,
+            "no_unbounded_table_export": True,
+            "sample_values_redacted": True,
+            "connection_values_redacted": True,
+        },
+        "status": "blocked",
+        "m2_ready": False,
+        "connection_status": "not_attempted",
+        "block_reason": None,
+        "owner_identifier_valid": valid_identifier(values.get("SAP_ORACLE_OWNER")),
+    }
+
+    if missing:
+        result["block_reason"] = "missing config keys: " + ", ".join(missing)
+    elif not dependency["oracledb_importable"]:
+        result["block_reason"] = "Oracle Python driver oracledb is not importable"
+    elif not result["owner_identifier_valid"]:
+        result["block_reason"] = "SAP_ORACLE_OWNER is missing or not a safe Oracle identifier"
+    else:
+        result["network_probe"] = tcp_probe(values)
+        if not result["network_probe"] or not result["network_probe"].get("ok"):
+            # 即使网络当前不可达，也单独探测本机 thick client，便于区分网络阻塞与本机驱动阻塞。
+            thick_probe = run_child("thick")
+            result["connection_attempts"] = [thick_probe]
+            thick_codes = thick_probe.get("codes") or []
+            if thick_probe.get("client_init") and not thick_probe["client_init"].get("ok"):
+                thick_codes = sorted(
+                    set(
+                        code
+                        for item in thick_probe["client_init"].get("attempts", [])
+                        for code in item.get("codes", [])
+                    )
+                )
+            result["block_reason"] = (
+                "TCP connectivity failed before SQL probe; "
+                f"local thick client probe codes={thick_codes or ['unknown']}"
+            )
+            result["connection_status"] = "fail"
+        else:
+            attempts = [run_child("thin"), run_child("thick")]
+            result["connection_attempts"] = attempts
+            summary = summarize_attempts(attempts)
+            result.update(summary)
+
+    write_outputs(result)
+    network_probe = result.get("network_probe")
+    terminal_summary = {
+        "status": result["status"],
+        "m2_ready": result["m2_ready"],
+        "config_presence": result["config_presence"],
+        "oracledb_importable": dependency["oracledb_importable"],
+        "oracledb_version": dependency.get("oracledb_version"),
+        "tcp_ok": network_probe.get("ok") if isinstance(network_probe, dict) else None,
+        "connection_status": result["connection_status"],
+        "block_reason": result.get("block_reason"),
+        "result_path": str(RESULT_PATH.relative_to(ROOT)),
+        "sanitized_path": str(SANITIZED_PATH.relative_to(ROOT)),
+    }
+    print(json.dumps(terminal_summary, ensure_ascii=False, indent=2))
+    return 0 if result["m2_ready"] else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/tmp/hermes/sap_mid_oracle_client_probe.py b/tmp/hermes/sap_mid_oracle_client_probe.py
