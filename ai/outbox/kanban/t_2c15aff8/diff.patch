+#!/usr/bin/env python3
+"""Run M1.5 SAP MID Oracle smoke acceptance checks and write sanitized logs."""
+from __future__ import annotations
+
+import os
+import subprocess
+import time
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+OUTDIR = ROOT / "ai" / "outbox" / "kanban" / "t_2c15aff8"
+TEST_LOG = OUTDIR / "test.log"
+PIP_CHECK_LOG = OUTDIR / "pip-check.log"
+CLIENT_STDOUT_LOG = OUTDIR / "client-probe.stdout.log"
+
+
+def run(cmd: list[str], *, env: dict[str, str] | None = None, timeout: int = 180) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(cmd, cwd=str(ROOT), env=env, text=True, capture_output=True, timeout=timeout, check=False)
+
+
+def append_command_log(lines: list[str], title: str, cmd: list[str], proc: subprocess.CompletedProcess[str]) -> None:
+    display = " ".join(cmd)
+    lines.extend([
+        "",
+        f"## {title}",
+        f"command: {display}",
+        f"exit_code: {proc.returncode}",
+        "stdout:",
+        proc.stdout.rstrip() or "(empty)",
+        "stderr:",
+        proc.stderr.rstrip() or "(empty)",
+    ])
+
+
+def main() -> int:
+    OUTDIR.mkdir(parents=True, exist_ok=True)
+    branch = run(["git", "branch", "--show-current"], timeout=30).stdout.strip()
+    status = run(["git", "status", "--short", "--", "backend/requirements.txt", "docs/SAP_MID_ORACLE_SMOKE_TEST_REPORT.md", "ai/outbox/kanban/t_2c15aff8"], timeout=30).stdout.rstrip()
+    lines: list[str] = [
+        "## M1.5 SAP MID Oracle read-only smoke rerun",
+        f"executed_at: {time.strftime('%Y-%m-%d %H:%M:%S %Z')}",
+        f"branch: {branch or '(unknown)'}",
+        "scope: read-only smoke only; no Oracle writes; no unbounded table export; no raw host/user/password/DSN output.",
+        "scoped_git_status_before_checks:",
+        status or "(clean for scoped paths)",
+    ]
+
