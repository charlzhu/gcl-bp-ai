@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT_DIR = ROOT / "ai" / "outbox" / "kanban" / "t_2c15aff8"
+OUT_DIR.mkdir(parents=True, exist_ok=True)
+OUT_PATH = OUT_DIR / "oracle_client_probe_safe_result.json"
+OPTIONAL_KEYS = ["ORACLE_CLIENT_LIB_DIR", "SAP_ORACLE_CLIENT_LIB_DIR"]
+
+
+def read_env_file(path: Path) -> dict[str, str]:
+    """读取可能的 Oracle Client 目录配置；只在内存中使用，不输出真实路径。"""
+    values: dict[str, str] = {}
+    if not path.exists():
+        return values
+    for raw in path.read_text(encoding="utf-8", errors="ignore").splitlines():
+        line = raw.strip()
+        if not line or line.startswith("#") or "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        key = key.strip()
+        value = value.strip().strip('"').strip("'")
+        if key in OPTIONAL_KEYS and value:
+            values[key] = value
+    return values
+
+
+def load_optional_config() -> dict[str, str]:
+    """合并 backend/.env 与进程环境变量中的 Oracle Client 目录配置。"""
+    values = read_env_file(ROOT / "backend" / ".env")
+    for key in OPTIONAL_KEYS:
+        if os.environ.get(key):
+            values[key] = os.environ[key]
+    return values
+
+
+ERROR_CODE_RE = re.compile(r"\b(?:DPY|DPI|ORA)-\d{4,5}\b")
+
+
+def safe_error(exc: BaseException) -> dict[str, object]:
+    """生成脱敏错误摘要；只保留错误类型和 Oracle 错误码，不输出路径/连接细节。"""
+    return {"error_type": type(exc).__name__, "codes": sorted(set(ERROR_CODE_RE.findall(str(exc))))}
+
+
+def candidate_client_dirs(cfg: dict[str, str]) -> list[str | None]:
+    """生成 thick 模式候选目录；结果中不记录真实路径。"""
+    seen: set[str | None] = set()
+    candidates: list[str | None] = []
+    for key in OPTIONAL_KEYS:
+        val = cfg.get(key)
+        if val and val not in seen:
+            seen.add(val)
+            candidates.append(val)
+    for val in [None, "/opt/oracle/instantclient", "/opt/homebrew/opt/instantclient/lib", "/opt/homebrew/lib", "/usr/local/lib"]:
+        if val not in seen:
+            seen.add(val)
+            candidates.append(val)
+    return candidates
+
+
+def main() -> int:
+    cfg = load_optional_config()
+    payload: dict[str, Any] = {
+        "executed_at": time.strftime("%Y-%m-%d %H:%M:%S %Z"),
+        "scope": "Oracle Client thick-mode availability probe only; no database connection; no host/user/password/DSN output",
+        "oracledb_importable": importlib.util.find_spec("oracledb") is not None,
+        "oracledb_version": None,
+        "optional_client_config_presence": {key: ("present" if cfg.get(key) else "missing") for key in OPTIONAL_KEYS},
+        "attempts": [],
+        "thick_client_available": False,
+        "status": "blocked",
+    }
+    if not payload["oracledb_importable"]:
+        payload["status"] = "blocked_oracledb_missing"
+        OUT_PATH.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+        print(json.dumps({"status": payload["status"], "thick_client_available": False, "result_path": str(OUT_PATH.relative_to(ROOT))}, ensure_ascii=False))
+        return 2
+
+    import oracledb  # type: ignore[import-not-found]
+
+    payload["oracledb_version"] = getattr(oracledb, "__version__", "unknown")
+    for idx, lib_dir in enumerate(candidate_client_dirs(cfg), start=1):
+        try:
+            if lib_dir:
+                oracledb.init_oracle_client(lib_dir=lib_dir)
+            else:
+                oracledb.init_oracle_client()
+            payload["attempts"].append({"attempt": idx, "lib_dir_redacted": bool(lib_dir), "ok": True})
+            payload["thick_client_available"] = True
+            payload["status"] = "passed"
+            break
+        except Exception as exc:  # noqa: BLE001
+            payload["attempts"].append({"attempt": idx, "lib_dir_redacted": bool(lib_dir), "ok": False, **safe_error(exc)})
+    OUT_PATH.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
+    print(json.dumps({
+        "status": payload["status"],
+        "oracledb_version": payload["oracledb_version"],
+        "thick_client_available": payload["thick_client_available"],
+        "attempt_count": len(payload["attempts"]),
+        "result_path": str(OUT_PATH.relative_to(ROOT)),
+    }, ensure_ascii=False))
+    return 0 if payload["thick_client_available"] else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

