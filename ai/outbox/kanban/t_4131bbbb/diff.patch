+def test_m5_shadow_compare_distinguishes_redacted_period_parameters(tmp_path: Path) -> None:
+    """对比签名必须比较期间参数安全指纹，不能因脱敏而把不同年月/季度/YTD 截止月判一致。"""
+
+    samples = [
+        InventorySalesProductionM5ShadowCompareSample(
