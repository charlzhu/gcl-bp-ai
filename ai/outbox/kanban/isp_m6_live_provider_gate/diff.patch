+def test_m6_cli_llm_smoke_prompt_is_compatible_with_json_object_response_format() -> None:
+    """LLM smoke 使用 json_object 响应格式时，提示词必须显式包含 JSON 关键词。"""
+
+    repo_root = Path(__file__).resolve().parents[3]
