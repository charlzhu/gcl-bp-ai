+                {"catalog_id": "metric:shipment_volume", "catalog_version": REQUIRED_ISP_SEMANTIC_CATALOG_VERSION},
+                {"catalog_id": "dimension:business_year", "catalog_version": REQUIRED_ISP_SEMANTIC_CATALOG_VERSION},
