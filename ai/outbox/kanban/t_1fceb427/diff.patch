+class LogisticsNl2SqlM7ReadonlySmokeSample(BaseModel):
+    """M7 只读中间库 shadow smoke 样例。
+
+    业务逻辑：
+        样例只保存业务问题模板和受控 SQLPlan candidate；真实数据库连接由 runner 读取 backend/.env 后
+        显式注入，只用于本阶段 shadow smoke，不接正式 QA 主链路。
+    """
+
