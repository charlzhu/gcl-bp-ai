+def test_source_ref_is_relative_and_redacted() -> None:
+    """验证 source_ref 不含本机绝对路径或敏感连接关键词。"""
+
+    bundle = NqeMetadataSyncBuilder(CATALOG_ROOT).build()
+    all_rows = (
