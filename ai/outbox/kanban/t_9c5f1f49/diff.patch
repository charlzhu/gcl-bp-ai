+def _collect_codes(bundle) -> list[str]:
+    """收集 bundle 中所有需要验证长度与幂等性的编码。"""
+
+    codes: list[str] = []
+    for group_name in (
+        "domains",
+        "data_sources",
+        "tables",
+        "columns",
+        "metrics",
+        "dimensions",
+        "business_rules",
+        "retrieval_chunks",
+        "metadata_versions",
+        "quality_gates",
+    ):
+        for row in getattr(bundle, group_name):
+            codes.append(row["code"])
+            if "chunk_code" in row:
+                codes.append(row["chunk_code"])
+    return codes
diff --git a/tests/unit/business_qa_graph/test_nqe_sql_agent_graph_skeleton.py b/tests/unit/business_qa_graph/test_nqe_sql_agent_graph_skeleton.py
