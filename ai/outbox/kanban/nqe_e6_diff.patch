"""


# -----------------------------------------------------------------------
# HTML 转义
# -----------------------------------------------------------------------

def _escape_html(text: str) -> str:
    """转义 HTML 特殊字符。

    参数：
        text: 原始文本。
    返回：
        转义后的安全文本。
    """
    return (
        text.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )

