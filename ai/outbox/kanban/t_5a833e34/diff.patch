     business_qa_graph_stream_events_enabled: bool = True
     business_qa_graph_audit_enabled: bool = True
+    # NQE 统一 SQL Agent 物流域独立灰度开关
+    # off = 不启用 NQE SQL Agent，完全走旧物流链路
+    # shadow = 旧链路返回用户结果，NQE SQL Agent 后台运行并记录 shadow compare
