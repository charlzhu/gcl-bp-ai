+    nqe_logistics_mode: Literal["off", "shadow", "assist", "on"] = "shadow"
     query_planning_v2_response_meta_enabled: bool = False
     business_qa_langgraph_enabled: bool = False
     # 掌柜问数对齐版 Graph 灰度开关
