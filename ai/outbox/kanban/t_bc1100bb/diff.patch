+class LogisticsNl2SqlDomainRoute(BaseModel):
+    """M9 domain router 结果。"""
+
+    model_config = ConfigDict(extra="forbid")
+
+    should_process: bool
+    domain: str
+    source_system: str = "middle_db"
+    mode: str = "shadow"
+    reason_code: str | None = None
