+            sample_id="skipped_missing_candidate",
+            description="缺少 SQLPlan candidate，应跳过 SQL 阶段",
+            request=LogisticsNl2SqlShadowPipelineRequest(
+                question="2025年物流发运量是多少",
+                request_id="m6-missing-candidate",
+                candidate=None,
