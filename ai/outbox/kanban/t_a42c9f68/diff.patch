+def test_evaluation_report_summarizes_status_stage_error_and_quality_metrics() -> None:
+    """M6 评估报表应确定性汇总状态、阶段、错误码与关键质量指标。"""
+
+    records = [
+        _record("success", "trial", sql_hash="a" * 64, explain_ok=True, trial_ok=True),
