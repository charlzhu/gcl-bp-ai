+def test_shadow_smoke_report_json_markdown_redacts_question_errors_warnings_sql_and_param_values() -> None:
+    """默认脱敏样例最终报表 JSON/Markdown 不能泄露 question/error/warning 中的 SQL、DSN 或密钥。"""
