+from __future__ import annotations
+
+import importlib
+from typing import Any
+
+
+INTERNAL_TERMS = (
+    "SQL",
+    "SELECT",
+    "FROM",
+    "table",
+    "column",
+    "query_key",
+    "planner",
+    "guardrail",
+    "schema",
+    "raw",
+    "debug",
+    "LLM",
+    "prompt",
+    "trace",
+)
+
