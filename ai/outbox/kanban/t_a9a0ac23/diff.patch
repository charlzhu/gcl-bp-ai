+    70|class DisambiguationService:
+    71|    """统一多候选消歧服务。
+    72|
+    73|    业务逻辑：
+    74|        不依赖数据库、LLM 或任何外部系统——只基于已解析的候选列表
+    75|        生成追问文本和解析用户选择。
+    76|    """
+    77|
+    78|    def generate_follow_up(
+    79|        self,
+    80|        question: str,
+    81|        entity_type: str,
+    82|        candidates: list[DisambiguationCandidate],
+    83|    ) -> str:
+    84|        """根据候选列表生成业务化追问文本。
+    85|
+    86|        参数：
+    87|            question: 原始用户问题（当前版本未直接用于追问生成，
+    88|                但保留参数以便后续增强）。
+    89|            entity_type: 实体类型。
+    90|            candidates: 消歧候选列表。
+    91|
+    92|        返回：
+    93|            中文业务追问文本。空候选时返回空字符串。
+    94|
+    95|        业务逻辑：
+    96|            1. 候选数量为 0 时返回空字符串——不应生成追问。
+    97|            2. 候选数量为 1 时返回确认式追问。
+    98|            3. 候选数量 >= 2 时返回标准多候选追问，包含可选实体值列表。
+    99|            4. 未知实体类型使用通用追问模板。
+   100|        """
+   101|        count = len(candidates)
+   102|        label = _entity_label(entity_type)
+   103|
+   104|        if count == 0:
+   105|            return ""
+   106|        if count == 1:
+   107|            return f"找到 1 个匹配的{label}：{candidates[0].display_label}。是否确认使用该{label}？"
+   108|
+   109|        # count >= 2：生成带候选列表的业务追问
+   110|        option_text = "、".join(
+   111|            f"{c.display_label}" for c in candidates[:5]
+   112|        )
+   113|        if count > 5:
+   114|            option_text += f" 等共 {count} 个"
+   115|
+   116|        return f"找到 {count} 个匹配的{label}：{option_text}。请选择一个{label}。"
+   117|
+   118|    def resolve_selection(
+   119|        self,
+   120|        candidates: list[DisambiguationCandidate],
+   121|        selected_id: str,
+   122|    ) -> DisambiguationCandidate:
+   123|        """根据用户选择的 candidate_id 解析对应候选。
+   124|
+   125|        参数：
+   126|            candidates: 消歧候选列表。
+   127|            selected_id: 用户选择的 candidate_id。
+   128|
+   129|        返回：
+   130|            匹配的 DisambiguationCandidate。
+   131|
+   132|        异常：
+   133|            DisambiguationError：候选列表为空或 candidate_id 不存在时抛出。
+   134|
+   135|        业务逻辑：
+   136|            fail-closed——unknown ID 或空列表必须抛异常，
+   137|            不可返回任意候选或 None。
+   138|        """
+   139|        if not candidates:
+   140|            raise DisambiguationError(
+   141|                "候选列表为空，无法进行消歧。请先通过实体解析器获取候选列表。"
+   142|            )
+   143|
+   144|        for c in candidates:
+   145|            if c.candidate_id == selected_id:
+   146|                return c
+   147|
+   148|        # 未找到匹配的 candidate_id
+   149|        known_ids = ", ".join(c.candidate_id for c in candidates)
+   150|        raise DisambiguationError(
+   151|            f"未找到 candidate_id='{selected_id}' 对应的候选。"
+   152|            f"可用的候选 ID：{known_ids}。"
+   153|        )
+   154|
+   155|
