# =========================
# 前端环境变量示例
# 复制本文件为 .env.local 后再按实际环境修改
# =========================

# 前端本地开发端口
VITE_PORT=5173

# 后端统一 API 前缀
# 浏览器默认请求同源 /api/v1，避免从非安全上下文直接访问内网后端触发 Chrome Private Network Access 告警。
VITE_API_PREFIX=/api/v1

# 本地开发代理目标，仅由 Vite dev server 使用，浏览器不会直接请求该地址。
# 例如本地后端默认是 http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 如确实没有反向代理、必须让浏览器直连后端，才配置该项。
# 注意：公网/HTTP 页面直连 127.0.0.1、192.168.*、10.* 等私有地址会触发 Chrome Private Network Access 风险或被阻断。
# VITE_DIRECT_API_BASE_URL=

# 应用标题
VITE_APP_TITLE=经营计划智能助手

# 是否开启调试日志
VITE_ENABLE_DEBUG=true
